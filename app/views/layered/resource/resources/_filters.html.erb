<%# The filter bar. Picking a filter from the "Add filter" popover adds it as
    an unset chip (tracked by the f[] param); pressing a chip's label opens
    the popover with its controls, and its ✕ removes it. Once a value is set
    the chip persists via its own q params and the f[] entry drops away. The
    bar lives inside the index turbo frame, so adding, applying, changing, or
    removing a filter is a single frame navigation that reloads the table and
    re-renders the chips. %>
<%# Chip order: pinned first (declaration order), then filters active straight
    from the URL (e.g. a bookmarked query), then user-added chips in the order
    they were added (the f[] list) — so a new chip always joins the end. %>
<% pinned, unpinned = layered_filters.partition { |f| f[:pinned] }
   added = layered_added_filter_attributes
   chips = pinned +
           unpinned.select { |f| layered_filter_active?(f) && !added.include?(f[:attribute].to_s) } +
           added.filter_map { |attr| unpinned.find { |f| f[:attribute].to_s == attr } }
   available = layered_filters - chips %>

<div class="l-ui-mt-3 l-ui-search-inline">
  <% chips.each do |filter| %>
    <% popover_id = "layered-filter-#{@layered_route_key}-#{filter[:attribute]}" %>
    <%# Button classes give the chip the same height/padding rhythm as the
        add-filter button; badge classes recolour it into a muted pill.

        The chip carries the popover controller itself (hand-rolling
        l_ui_popover's markup) so the WHOLE pill is the measured trigger
        target — Stimulus scopes include the root element — which
        left-justifies the popover with the pill and opens it a gap below the
        pill's full height rather than the shorter label button inside. The
        helper can't express that while the ✕ sits beside the trigger button. %>
    <div class="l-ui-button l-ui-button--small l-ui-badge--default l-ui-badge--rounded"
         data-controller="l-ui--popover"
         data-l-ui--popover-target="trigger">
      <%# Tailwind v4's preflight gives buttons cursor: default, overriding
          the container's pointer — and no l-ui class carries just a cursor. %>
      <%= tag.button type: "button", popovertarget: popover_id, style: "cursor: pointer",
            aria: { label: "Edit #{layered_filter_label(filter)} filter" } do %>
        <%= layered_filter_active?(filter) ? layered_filter_chip_text(filter) : layered_filter_label(filter) %>
      <% end %>
      <%# A pinned chip is always shown, so it has no remove ✕ — its popover's
          Clear resets the value but the chip stays. %>
      <% unless filter[:pinned] %>
        <%= link_to layered_filter_remove_path(filter),
              aria: { label: "Remove #{layered_filter_label(filter)} filter" },
              data: { turbo_frame: turbo_frame_name, turbo_action: "advance" } do %>
          <%# Same drawing style and size as the add-filter plus, inheriting
              the chip's muted text colour. %>
          <svg class="l-ui-icon--xs" fill="none" stroke="currentColor" stroke-width="2"
               viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        <% end %>
      <% end %>
      <%= tag.div id: popover_id, popover: "auto", class: "l-ui-popover",
            data: { "l-ui--popover-target": "popover" } do %>
        <%= render "filter_control", filter: filter, turbo_frame_name: turbo_frame_name %>
      <% end %>
    </div>
  <% end %>

  <% if available.any? %>
    <%= l_ui_popover do |p| %>
      <% p.trigger(class: "l-ui-button l-ui-button--outline l-ui-button--small") do %>
        <%# Inline plus (stroke follows the button's text colour) — a text "+"
            is capped at the button's text-xs and reads too small. %>
        <svg class="l-ui-icon--xs" fill="none" stroke="currentColor" stroke-width="2"
             viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
        </svg>
        Add filter
      <% end %>
      <div class="l-ui-popover__menu">
        <% available.each do |filter| %>
          <%= link_to layered_filter_label(filter), layered_filter_add_path(filter),
                class: "l-ui-popover__menu-item",
                data: { turbo_frame: turbo_frame_name, turbo_action: "advance" } %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
